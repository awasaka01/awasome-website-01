{
	"name": "awasomewebsite",
	"version": "1.0.0",
	"description": "",
	"type": "module",
	"scripts": {
		"beforeBuild": "node ./scripts/beforeBuild.js",
		"afterBuild": "node ./scripts/afterBuild.js",

		"eleventy-build": "eleventy",
		"eleventy-serve": "eleventy --incremental --serve",

		"dev": "npm-run-all -s beforeBuild eleventy-serve",
		"devbuild": "npm-run-all -s beforeBuild eleventy-build afterBuild",

		"build": "cross-env FULL_BUILD=1 npm-run-all -s beforeBuild eleventy-build afterBuild",		
		"buildauto": "cross-env FULL_BUILD=1 FULL_START=1 npm-run-all -s beforeBuild -p buildauto:1 buildauto:2",
		"buildauto:1": "nodemon --watch .eleventy.js --watch src --ext \"*\" --exec \"pnpm run build\" --delay 4",
		"buildauto:2": "serve __production -p 8080 -n"
	},
	"browserslist": "> 0.1%",
	"keywords": [],
	"author": "",
	"license": "ISC",
	"packageManager": "pnpm@10.12.1",
	"dependencies": {
		"@11ty/eleventy": "^3.1.1",
		"@11ty/eleventy-img": "^6.0.4",
		"@vitejs/plugin-react": "^4.7.0",
		"ansis": "^4.1.0",
		"chalk": "^5.4.1",
		"chroma-js": "^3.1.2",
		"cross-env": "^10.0.0",
		"dotenv": "^17.2.0",
		"eleventy": "^1.0.7",
		"html-minifier-terser": "^7.2.0",
		"jsdom": "^26.1.0",
		"lightningcss": "^1.30.1",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"sass-embedded": "^1.89.2",
		"vite": "^6.3.5",
		"vite-plugin-image-optimizer": "^2.0.2"
	},
	"pnpm": {
		"neverBuiltDependencies": []
	},
	"devDependencies": {
		"@stylistic/stylelint-config": "^2.0.0",
		"@types/chroma-js": "^3.1.1",
		"@types/jsdom": "^21.1.7",
		"@types/node": "^24.0.3",
		"nodemon": "^3.1.10",
		"npm-run-all": "^4.1.5",
		"serve": "^14.2.4",
		"stylelint": "^16.19.0",
		"stylelint-config-sass-guidelines": "^12.1.0",
		"stylelint-config-standard-scss": "^15.0.1",
		"stylelint-define-config": "^16.19.0",
		"ts-node": "^10.9.2",
		"typescript": "^5.8.3"
	}
}