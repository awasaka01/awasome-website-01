<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{{ title || "default title" }}</title>

	{{# Include the image loader script only when necessary #}}
	{{ if process.env.FULLBUILD === "true" }} <script src="/awa-util/progressive_image_loading.js"></script> {{ /if }}

	{{ head }}
</head>
<body>
	{{ content }}
</body>
</html>