{
	// To be used with the 'Toggle Excluded Files' extension
	"files.exclude": {
		"**/.github/": true,
		"**/__dev/": true,
		"**/.cache/": true,
		"**/.gitignore": true,
		"**/jsconfig.json": true,
		"**/node_modules/": true,
		"**/package.json": true,
		"**/pnpm-lock.yaml": true,
		"**/pnpm-workspace.yaml": true,
		"**/eslint.config.mjs": true,
		"**/stylelint.config.mjs": true
	},
	"terminal.integrated.minimumContrastRatio": 1,
	// Disable default validation since stylelint is used
	"css.validate": false,
	"less.validate": false,
	"scss.validate": false,
	"editor.codeActionsOnSave": { "source.fixAll.stylelint": "explicit" },
	// Buttons to run the commands easier 
	"actionButtons": {
		"commands": [
			{
				"name": "$(tools) Build",
				"command": "pnpm run build"
			},
			{
				"name": "$(eye) Live Preview",
				"command": "pnpm run start"
			},
		],
		"defaultColor": "none",
		"reloadButton": "↻",
		"loadNpmCommands": false
	},
	// "commentAnchors.workspace.lazyLoad": true,
	// "commentAnchors.workspace.excludeFiles": "**/{__dist,node_modules,.git,.idea,target,out,build,bin,obj,dist,vendor}/**/*",
	// "commentAnchors.workspace.pathFormat": "full",
	"editor.wordSeparators": "`~!@#$%^&*()=+[{]}\\|;:'\",.<>/?", // remove '-' from the list to allow double clicking on words to copy them
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": [
                    "comment",
                    "punctuation.definition.comment",
                ],
                "settings": {
                    "fontStyle": ""
                }
            }
        ]
    },
	"files.associations": {
		"*.html": "liquid",
	}
}