    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Cons Launch Program",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${file}",
            "outputCapture": "console",
            "console": "internalConsole"
        },
		{
            "type": "node",
            "request": "launch",
            "name": "Term Launch Program ",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${file}",
            "outputCapture": "std",
            "console": "integratedTerminal",
        }
    ]
}