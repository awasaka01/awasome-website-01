{
	// Use IntelliSense to learn about possible attributes.
	// Hover to view descriptions of existing attributes.
	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"configurations": [
		{
			"command": "nodemon",
			"name": "Color Preview",
			"request": "launch",
			"type": "node-terminal",
			"cwd": "${cwd}/scripts/color-preview"
		},
		{
			"command": "pnpm run start",
			"name": "Development server",
			"request": "launch",
			"type": "node-terminal"
		},
		{
			"command": "pnpm run build",
			"name": "Build",
			"request": "launch",
			"type": "node-terminal"
		},
		{
			"type": "node",
			"request": "launch",
			"name": "Run current file in Console",
			"skipFiles": [
				"<node_internals>/**"
			],
			"program": "${file}",
			"outputCapture": "console",
			"console": "internalConsole"
		},
		{
			"type": "node",
			"request": "launch",
			"name": "Run current file in Terminal",
			"skipFiles": [
				"<node_internals>/**"
			],
			"program": "${file}",
			"outputCapture": "std",
			"console": "integratedTerminal",
		}
	]
}